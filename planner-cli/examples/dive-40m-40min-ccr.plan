# Example 3: CCR trimix dive (diluent tx10/50) at 40 m for 40 min,
# constant setpoint 1.2 bar, Bühlmann GF 35/75.
# The bailout cylinder is declared but not used (no 'bailout on').

mode ccr
setpoint 1.2
deco-mode buehlmann
gflow 35
gfhigh 75

cyl tx10/50 3l 200bar use=diluent
cyl air 12l 200bar use=bailout

go 40m gas=0
hold 40min

# Deco is computed for diving the loop at the constant setpoint.
# For an OC bailout scenario add 'bailout on' before 'go'.
