#!/usr/bin/env subsurface-plan
# Example 2: trimix dive with deco gases, equivalent to the dive used in
# subsurface's TestPlan::testMetric() (testplan.cpp), so results can be
# validated against the reference implementation's known values
# (minimum gas 148 bar, gas changes at 33 m and 6 m, runtime ~109 min).

deco-mode buehlmann
gflow 100
gfhigh 100
salinity 10300

# rates as used by testplan.cpp setupPrefs()
ascent-rate 9.1        # 30 ft/min
ascent-rate-stops 9.1
ascent-rate-6m 3       # 10 ft/min
last-stop 6
timestep 60

# cylinders as in setupPlan(): tx15/45 36l, ean36, oxygen (all at 232 bar)
cyl tx15/45 36l 232bar
cyl ean36   12l 232bar
cyl oxygen  3l  232bar

# deco gas switch depths (max. pO2 1.6 bar): EAN36 at <= 33 m, O2 at <= 6 m
cyl-change 1 33m
cyl-change 2 6m

# the dive: descend to 79 m, be back at the surface 30 min later
# (testplan encodes the bottom phase as 30 min *including* descent,
#  descent at 23 m/min => 206 s, so we hold 30 min - 206 s at depth)
descent-rate 23
go 79m gas=0
hold 26min34s
